<?xml version="1.0"?>
<ruleset name="StellarWP Core Update Notice">
	<description>PSR-12 for this package. It is a PSR-4 library, not plugin code, so it follows the
		same conventions as the other StellarWP composer packages rather than the WordPress
		standard.</description>

	<file>src</file>
	<file>tests</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="PSR12"/>

	<!-- The bootstrap is a script, not a class file; it necessarily has side effects. -->
	<rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
		<exclude-pattern>tests/bootstrap.php</exclude-pattern>
	</rule>

	<config name="testVersion" value="7.4-"/>
</ruleset>
