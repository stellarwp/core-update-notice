<?xml version="1.0"?>
<ruleset name="StellarWP Core Update Notice">
	<description>Nexcess coding standards for this PHP 7.4+ WordPress library.</description>

	<file>src</file>
	<file>tests</file>

	<arg name="basepath" value="." />
	<arg name="extensions" value="php" />
	<arg name="severity" value="4" />
	<arg name="tab-width" value="4" />
	<arg name="parallel" value="80" />
	<arg name="colors" />
	<arg value="sp" />

	<config name="testVersion" value="7.4-" />
	<config name="php_version" value="70433" />
	<config name="minimum_supported_wp_version" value="6.6" />

	<rule ref="Nexcess" />
</ruleset>
